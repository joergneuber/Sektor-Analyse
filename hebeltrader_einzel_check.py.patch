+def teile_validierte_kandidaten(
+    validierte: list[dict[str, Any]],
+) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
+    """Teilt validierte Kandidaten in Einzel-Check-Auswahl und Zurückgestellte.
+
+    Die bestehende Priorisierung ist bereits in yahoo_validiere() erfolgt.
+    Die Reihenfolge wird deshalb unverändert übernommen. Zurückgestellte
+    Kandidaten werden mit einem expliziten Status und Grund dokumentiert.
+    """
+    ausgewaehlt = validierte[:MAX_VALIDIERTE_KANDIDATEN]
+    zurueckgestellt = []
+    for candidate in validierte[MAX_VALIDIERTE_KANDIDATEN:]:
+        deferred = dict(candidate)
+        deferred["einzel_check_status"] = "ZURUECKGESTELLT_LIMIT"
+        deferred["deferred_reason"] = (
+            f"Obergrenze MAX_VALIDIERTE_KANDIDATEN="
+            f"{MAX_VALIDIERTE_KANDIDATEN} erreicht"
+        )
+        zurueckgestellt.append(deferred)
+    return ausgewaehlt, zurueckgestellt

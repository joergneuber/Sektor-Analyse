+        "bls.gov", "www.bls.gov",
+        "dol.gov", "www.dol.gov",
+        "adp.com", "www.adp.com",
+        "federalreserve.gov", "www.federalreserve.gov",
+        "bea.gov", "www.bea.gov",
+        "ecb.europa.eu",
+        "eia.gov", "www.eia.gov",

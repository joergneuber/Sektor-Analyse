name: IEA Forensic Discovery

on:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  iea-forensic-discovery:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.13"

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install requests playwright

      - name: Install Chromium
        run: |
          python -m playwright install --with-deps chromium

      - name: Run IEA forensic discovery
        run: |
          python iea_forensic_discovery.py \
            --wait 20 \
            --output iea_forensic_discovery

      - name: Upload forensic results
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: iea-forensic-discovery
          path: iea_forensic_discovery/
          if-no-files-found: warn
          retention-days: 14
